# ==============================================================================
# Fútbol Libre TV - Apache / cPanel .htaccess Configuration
# 1. Force HTTPS (SSL)
# 2. Redirect WWW to Non-WWW (301 Permanent SEO Redirect)
# 3. Security, Caching & Performance Optimizations
# ==============================================================================

RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------------------
# 1. Force HTTPS & Redirect WWW to Non-WWW
# Redirects https://www.futbollibre-tv.sx/... -> https://futbollibre-tv.sx/...
# Redirects http://www.futbollibre-tv.sx/...  -> https://futbollibre-tv.sx/...
# Redirects http://futbollibre-tv.sx/...      -> https://futbollibre-tv.sx/...
# ------------------------------------------------------------------------------

# Case A: If WWW is present, redirect to non-WWW over HTTPS
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Case B: If not HTTPS, redirect to HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ------------------------------------------------------------------------------
# 2. Custom 404 Error Page
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# 3. Disable Directory Browsing for Security
# ------------------------------------------------------------------------------
Options -Indexes

# ------------------------------------------------------------------------------
# 4. UTF-8 Character Encoding
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json

# ------------------------------------------------------------------------------
# 5. GZIP Compression (mod_deflate / LiteSpeed)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6. Browser Caching (mod_expires)
# Long cache for static assets, short cache for live match agenda
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML Documents (keep fresh)
    ExpiresByType text/html "access plus 0 seconds"

    # Match Agenda & Stream Config (frequent live updates)
    ExpiresByType application/json "access plus 60 seconds"

    # Static CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Images and Media
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 7. Prevent Cache for eventos.js & config.js (Ensures Live Matches Update)
# ------------------------------------------------------------------------------
<FilesMatch "^(eventos\.js|config\.js)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=60, public, must-revalidate"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 8. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
