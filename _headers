/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade

/css/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/flags/*
  Cache-Control: public, max-age=31536000, immutable

/config.js
  Cache-Control: public, max-age=60, must-revalidate

/eventos.js
  Cache-Control: public, max-age=60, must-revalidate
